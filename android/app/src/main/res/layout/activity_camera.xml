<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101A15">

    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#E6183D2B"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RoadGuard · Dashcam"
            android:textColor="#F5FFDC"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/txtTelemetryStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Camera not started"
            android:textColor="#D5E7D0"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/txtSeverityBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FF2800"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="MODEL OFFLINE"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#E6183D2B"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView
            android:id="@+id/txtDetectionSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No AI detections are being generated."
            android:textColor="#F5FFDC"
            android:textSize="12sp" />
        <Button
            android:id="@+id/btnRecordDashcam"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#FF2800"
            android:text="● Start recording"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnCaptureAudit"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:backgroundTint="#228B22"
                android:text="Save evidence frame"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
            <Button
                android:id="@+id/btnCloseCamera"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:backgroundTint="#F5FFDC"
                android:text="Close camera"
                android:textAllCaps="false"
                android:textColor="#183D2B"
                android:textSize="12sp" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Recording stops when this app leaves the foreground. No certified AI detection is active in this build."
            android:textColor="#D5E7D0"
            android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
